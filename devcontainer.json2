{
  "name": "Trading Ontology Chatbot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [7860],
  "portsAttributes": {"7860": {"label": "Trading Chatbot", "onAutoForward": "openBrowser"}},
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "postStartCommand": "echo 'Run: python app.py (requires OPENAI_API_KEY and ONTOLOGY_BASE_URL Codespaces secrets)'"
}
